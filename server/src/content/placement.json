{
  "questions": [
    {
      "id": "pl-header",
      "tier": 1,
      "prompt": "Which line starts every DataWeave 2.0 script?",
      "options": [
        "version: 2.0",
        "%dw 2.0",
        "@dw 2.0",
        "#dataweave 2"
      ],
      "answer": 1,
      "explanation": "The header begins with the version directive `%dw 2.0`; `---` separates the header from the body."
    },
    {
      "id": "pl-map",
      "tier": 1,
      "prompt": "What does `[1, 2, 3] map $ * 2` return?",
      "options": [
        "[2, 4, 6]",
        "12",
        "[1, 2, 3, 1, 2, 3]",
        "An error"
      ],
      "answer": 0,
      "explanation": "`map` applies the expression to each element; `$` is the current element.",
      "check": {
        "script": "[1,2,3] map $ * 2",
        "expected": [
          2,
          4,
          6
        ]
      }
    },
    {
      "id": "pl-default",
      "tier": 1,
      "prompt": "`payload` is `{}`. What does `payload.name default \"anon\"` return?",
      "options": [
        "An error",
        "null",
        "\"\"",
        "\"anon\""
      ],
      "answer": 3,
      "explanation": "Selecting a missing key gives null, and `default` replaces null with its right-hand side.",
      "check": {
        "script": "payload.name default \"anon\"",
        "expected": "anon"
      }
    },
    {
      "id": "pl-filter",
      "tier": 2,
      "prompt": "What does `[1, 2, 3, 4] filter (($ mod 2) == 0)` return?",
      "options": [
        "[1, 3]",
        "[true, false, true, false]",
        "[2, 4]",
        "2"
      ],
      "answer": 2,
      "explanation": "`filter` keeps elements for which the condition is true. The parentheses matter: `==` binds tighter than `mod`.",
      "check": {
        "script": "[1,2,3,4] filter (($ mod 2) == 0)",
        "expected": [
          2,
          4
        ]
      }
    },
    {
      "id": "pl-pluck",
      "tier": 2,
      "prompt": "What does `{a: 1, b: 2} pluck $$` return?",
      "options": [
        "[[\"a\", 1], [\"b\", 2]]",
        "[\"a\", \"b\"]",
        "{a: 1, b: 2}",
        "[1, 2]"
      ],
      "answer": 1,
      "explanation": "In `pluck`, `$` is each value and `$$` each key.",
      "check": {
        "script": "{a:1, b:2} pluck $$",
        "expected": [
          "a",
          "b"
        ]
      }
    },
    {
      "id": "pl-reduce",
      "tier": 2,
      "prompt": "What does `[1, 2, 3] reduce ((item, acc = 0) -> acc + item)` return?",
      "options": [
        "6",
        "3",
        "[1, 3, 6]",
        "0"
      ],
      "answer": 0,
      "explanation": "`reduce` folds the array into one value, starting from the accumulator's default.",
      "check": {
        "script": "[1,2,3] reduce ((item, acc = 0) -> acc + item)",
        "expected": 6
      }
    },
    {
      "id": "pl-split",
      "tier": 3,
      "prompt": "What does `\"a,b,c\" splitBy \",\"` return?",
      "options": [
        "[\"a,b,c\"]",
        "\"abc\"",
        "An error",
        "[\"a\", \"b\", \"c\"]"
      ],
      "answer": 3,
      "explanation": "`splitBy` splits a string on a separator into an array of strings.",
      "check": {
        "script": "\"a,b,c\" splitBy \",\"",
        "expected": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "id": "pl-groupby",
      "tier": 3,
      "prompt": "Given `[{t: \"x\"}, {t: \"y\"}, {t: \"x\"}] groupBy $.t`, how many items are under key `x`?",
      "options": [
        "3",
        "0",
        "2",
        "1"
      ],
      "answer": 2,
      "explanation": "`groupBy` returns an object whose keys are the criteria results and whose values are arrays of matching items.",
      "check": {
        "script": "sizeOf(([{t:\"x\"},{t:\"y\"},{t:\"x\"}] groupBy $.t).x)",
        "expected": 2
      }
    },
    {
      "id": "pl-flatten",
      "tier": 3,
      "prompt": "What does `flatten([[1, 2], [3]])` return?",
      "options": [
        "[[1, 2], [3]]",
        "[1, 2, 3]",
        "[1, [2, 3]]",
        "6"
      ],
      "answer": 1,
      "explanation": "`flatten` removes one level of nesting from an array of arrays.",
      "check": {
        "script": "flatten([[1,2],[3]])",
        "expected": [
          1,
          2,
          3
        ]
      }
    }
  ]
}
