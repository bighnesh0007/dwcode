{
  "name": "dwcode-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DWCode application backend \u2014 business logic, data access, validation and integrations.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx/esm --watch src/server.ts",
    "start": "node dist/server.js",
    "prebuild": "npm run build --workspace @dwcode/shared --prefix ..",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "audit:problems": "node --env-file-if-exists=.env scripts/audit-problems.mjs",
    "migrate:odd-even": "node --env-file-if-exists=.env scripts/migrations/003-fix-odd-even-solution.mjs",
    "migrate:expectations": "node --env-file-if-exists=.env scripts/migrations/004-regenerate-mismatched-expectations.mjs",
    "migrate:solutions": "node --env-file-if-exists=.env scripts/migrations/005-fix-broken-solutions.mjs",
    "pg:generate": "drizzle-kit generate",
    "pg:migrate": "drizzle-kit migrate",
    "pg:check": "drizzle-kit check",
    "pg:copy": "node --env-file-if-exists=.env --import tsx/esm scripts/pg/copy-from-mongo.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.26.1",
    "@dwcode/shared": "*",
    "@google/genai": "^2.8.0",
    "bullmq": "^5.81.5",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.0.0",
    "mongoose": "9.12.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.8.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
