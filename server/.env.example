# Copy to server/.env and fill in. Every variable is validated at startup by
# src/config/env.ts, which lists defaults and the full set of options.

PORT=4000
# Matches docker-compose.yml. Never point local dev at production.
MONGODB_URI=mongodb://dwcode:dwcode-local-dev@127.0.0.1:27017/dwcode?authSource=admin

CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Optional
# GEMINI_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_STATE_SECRET=
# TOKEN_ENCRYPTION_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
HEALTHCHECK_ENABLED=false

# Compiler service (docker compose up -d compiler). DW_BACKEND=upstream keeps
# the old third-party compiler; "service" uses ours.
# DW_BACKEND=service
# COMPILER_SERVICE_URL=http://127.0.0.1:8080
# COMPILER_AUTH_TOKEN=local-dev-compiler-token-0123456789abcdef

# Shared rate limits / cache / grading queue (docker compose up -d redis).
# REDIS_URL=redis://127.0.0.1:6379
LOG_PRETTY=true
