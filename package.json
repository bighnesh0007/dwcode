{
  "name": "dwcode",
  "version": "1.0.0",
  "private": true,
  "description": "DWCode monorepo — Next.js client + layered application backend.",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta --kill-others-on-fail \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",

    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",

    "start": "concurrently -n client,server -c cyan,magenta \"npm:start:client\" \"npm:start:server\"",
    "start:client": "npm --prefix client run start",
    "start:server": "npm --prefix server run start",

    "lint": "npm --prefix client run lint && npm --prefix server run lint",
    "typecheck": "npm --prefix server run typecheck",
    "test": "npm --prefix server run test",

    "setup": "npm install && npm --prefix client install && npm --prefix server install",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}

