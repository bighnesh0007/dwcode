<?xml version="1.0" encoding="UTF-8"?>
<!--
  DWCode compiler service: the DataWeave engine embedded in warm JVM workers.
  See docs/vault/Decisions/ADR-006 Own JVM Compiler Service.md.

  Maven, not Gradle: it was already on the build machines, and this project
  needs nothing a plain build does not give it.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.dwcode</groupId>
  <artifactId>dwcode-compiler</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      The engine version is a parity decision, not a preference: it is pinned to
      whatever reproduces the captured corpus (compiler/parity/). Override with
      -Dweave.version=... to run the corpus against a candidate.
    -->
    <weave.version>2.12.2</weave.version>
    <jackson.version>2.18.2</jackson.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <repositories>
    <!-- org.mule.weave is published here, not on Maven Central. Apache-2.0 (POM). -->
    <repository>
      <id>mulesoft-releases</id>
      <url>https://repository.mulesoft.org/nexus/content/repositories/releases/</url>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.mule.weave</groupId>
      <artifactId>runtime</artifactId>
      <version>${weave.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.weave</groupId>
      <artifactId>core-modules</artifactId>
      <version>${weave.version}</version>
    </dependency>
    <!-- Input/output formats the playground offers beyond the core set. -->
    <dependency>
      <groupId>org.mule.weave</groupId>
      <artifactId>yaml-module</artifactId>
      <version>${weave.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.weave</groupId>
      <artifactId>ndjson-module</artifactId>
      <version>${weave.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- The engine logs through SLF4J; without a binding it prints a warning per process. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.16</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>dwcode-compiler</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Pool tests spawn workers from the test classpath. -->
          <useModulePath>false</useModulePath>
          <!-- Workers inherit java.class.path; a manifest-only booter jar would hide the real one. -->
          <useManifestOnlyJar>false</useManifestOnlyJar>
        </configuration>
      </plugin>
      <plugin>
        <!-- Thin jar + lib/ directory: workers are launched with the same classpath. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.dwcode.compiler.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
