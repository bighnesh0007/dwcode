# Copy to client/.env.local and fill in. Only the Clerk keys and MONGODB_URI are
# needed to boot; everything else switches a feature on and is reported as
# disabled when absent (see lib/config.ts).

# ── Required ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Matches docker-compose.yml. Never point local dev at production.
MONGODB_URI=mongodb://dwcode:dwcode-local-dev@127.0.0.1:27017/dwcode?authSource=admin

# ── PostgreSQL (issue #23) ────────────────────────────────────────────────────
# Target of `pg:migrate` and `pg:copy -- --apply`, and of DATA_BACKEND below.
# DATABASE_URL=postgresql://dwcode:dwcode-local-dev@127.0.0.1:5432/dwcode
# mongo (default) | shadow (serve Mongo, compare with Postgres) | postgres
# DATA_BACKEND=mongo

# ── URLs ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000
# DataWeave compiler used by the playground.
DWL_BACKEND_URL=http://localhost:4000

# ── Optional features ─────────────────────────────────────────────────────────
# GEMINI_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SUPER_ADMIN_USER_ID=
NEXT_PUBLIC_SHOW_ADMIN=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
GUEST_MIGRATION_ENABLED=false
# Grade hidden test cases too (issue #10). Run `npm run audit:problems` first.
GRADE_HIDDEN_TESTS=false
