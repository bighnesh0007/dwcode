{
  "name": "dwcode-client",
  "version": "1.0.0",
  "private": true,
  "description": "DWCode frontend — Next.js presentation layer.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 8000",
    "prebuild": "npm run build --workspace @dwcode/shared --prefix ..",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:notes": "node --env-file-if-exists=.env.local scripts/migrations/001-scope-notes-to-user.mjs",
    "indexes": "tsx --env-file-if-exists=.env.local scripts/ensure-indexes.ts",
    "seed:expert": "tsx --env-file-if-exists=.env.local scripts/seed-expert-problems.ts",
    "migrate:comments": "node --env-file-if-exists=.env.local scripts/migrations/002-generalise-comments.mjs",
    "migrate:odd-even": "node --env-file-if-exists=.env.local scripts/migrations/003-fix-odd-even-solution.mjs",
    "audit:problems": "node --env-file-if-exists=.env.local scripts/audit-problems.mjs",
    "pg:generate": "drizzle-kit generate",
    "pg:migrate": "drizzle-kit migrate",
    "pg:check": "drizzle-kit check",
    "pg:copy": "tsx --env-file-if-exists=.env.local scripts/pg/copy-from-mongo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.5.7",
    "@dwcode/shared": "*",
    "@google/genai": "^2.8.0",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "json5": "^2.2.3",
    "lucide-react": "^1.21.0",
    "mongoose": "^9.8.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/runner": "^4.1.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsx": "4.20.3",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.9"
  }
}
